# ==============================================================================
# GESTIONNAIRE COMMERCIAL SAAS VTM — MODÈLE PRODUCTION (.env / RENDER)
# ==============================================================================
# ATTENTION : Ne committez JAMAIS de vrais secrets dans ce fichier !
# Ce fichier sert de référence pour configurer les variables d'environnement
# sur Render (Dashboard Render > Service > Environment) ou tout serveur de prod.

# --- 1. Base de données PostgreSQL (Render PostgreSQL) ---
# Fournie automatiquement par Render Blueprint via `fromDatabase: { name: vtm-postgres, property: connectionString }`
DATABASE_URL="postgresql://gestionnaire:VOTRE_MOT_DE_PASSE_SECURISE@dpg-xxxx-a.frankfurt-postgres.render.com/gestionnaire_prod?sslmode=require"

# Optionnel : Rôles dédiés à privilège minimal (créés par migrations)
# Si omis, l'API utilise DATABASE_URL en fallback transparent
# DATABASE_URL_RUNTIME="postgresql://app_runtime:VOTRE_MOT_DE_PASSE_RUNTIME@dpg-xxxx-a.frankfurt-postgres.render.com/gestionnaire_prod?sslmode=require"
# DATABASE_URL_PLATFORM="postgresql://platform_runtime:VOTRE_MOT_DE_PASSE_PLATFORM@dpg-xxxx-a.frankfurt-postgres.render.com/gestionnaire_prod?sslmode=require"
# DATABASE_URL_WORKER="postgresql://worker_runtime:VOTRE_MOT_DE_PASSE_WORKER@dpg-xxxx-a.frankfurt-postgres.render.com/gestionnaire_prod?sslmode=require"

# --- 2. Authentification & Chiffrement JWT ---
# Sur Render, généré automatiquement par Blueprint avec `generateValue: true`
# En déploiement manuel : `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_ACCESS_SECRET="GENEREZ_UNE_CLE_SECRETE_MIN_64_CARACTERES"
JWT_REFRESH_SECRET="GENEREZ_UNE_CLE_SECRETE_REFRESH_MIN_64_CARACTERES"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- 3. Configuration Réseau API & Render ---
NODE_ENV="production"
PORT=10000
API_PORT=10000
API_CORS_ORIGIN="https://vtm-client.onrender.com,https://vtm-admin.onrender.com,https://vtm-site.onrender.com,https://app.vtm-market.com,https://admin.vtm-market.com,https://vtm-market.com"

# --- 4. Variables Frontend (au build Vite) ---
# VITE_API_URL="https://vtm-api.onrender.com"
# VITE_CLIENT_URL="https://vtm-client.onrender.com"

# --- 5. Sécurité Réinitialisation (BLOQUÉ PAR DÉFAUT EN PROD) ---
# En production, la réinitialisation globale de la plateforme est FORMELLEMENT INTERDITE.
# Ne JAMAIS activer ALLOW_PLATFORM_RESET en production.
# ALLOW_PLATFORM_RESET="false"

# --- 6. Passerelle Email SMTP Transactionnel (Optionnel au lancement) ---
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@vtm-market.com"
SMTP_PASSWORD="VOTRE_SMTP_PASSWORD"
SMTP_FROM="ViralTech Market <notifications@vtm-market.com>"

# --- 7. Fournisseurs de Paiement Mobile Money & Cartes (Futur / Webhooks) ---
WAVE_API_KEY=""
WAVE_WEBHOOK_SECRET=""
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""

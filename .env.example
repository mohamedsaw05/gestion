# Copier ce fichier en .env et .env.test, et ajuster si besoin.
# Ne jamais committer de vrai secret : ce fichier ne contient que des valeurs de développement local.

# --- Base de données (packages/db, apps/api) ---
DATABASE_URL="postgresql://gestionnaire:gestionnaire_dev_password@localhost:5442/gestionnaire_dev?schema=public"

# Base dédiée aux tests d'intégration (créée séparément, cf docs/TESTING.md)
DATABASE_URL_TEST="postgresql://gestionnaire:gestionnaire_dev_password@localhost:5442/gestionnaire_test?schema=public"

# Connexion RUNTIME de l'API (apps/api) : rôle app_runtime, SANS BYPASSRLS.
# Créé par la migration packages/db/prisma/migrations/*_init. Ne jamais utiliser
# DATABASE_URL (superuser) pour le trafic applicatif — cf docs/architecture/07-securite.md §3.
DATABASE_URL_RUNTIME="postgresql://app_runtime:app_runtime_dev_password@localhost:5442/gestionnaire_dev?schema=public"

# Rôles à privilège minimal pour les deux besoins légitimement cross-tenant
# (cf migration least_privilege_roles et docs/PROJECT_STATUS.md §3) : jamais
# BYPASSRLS, chacun avec une policy RLS explicite et étroite.
DATABASE_URL_PLATFORM="postgresql://platform_runtime:platform_runtime_dev_password@localhost:5442/gestionnaire_dev?schema=public"
DATABASE_URL_WORKER="postgresql://worker_runtime:worker_runtime_dev_password@localhost:5442/gestionnaire_dev?schema=public"

# --- Redis (cache, rate limiting) ---
REDIS_URL="redis://localhost:6390"

# --- Auth (apps/api) ---
# Secrets de DEV uniquement. En production : générés aléatoirement et stockés dans un coffre-fort de secrets.
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- API ---
API_PORT=4000
API_CORS_ORIGIN="http://localhost:5180"

# --- Web ---
VITE_API_URL="http://localhost:4000"
